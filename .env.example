# Threat Intelligence Platform - Docker environment
# ./docker-start.sh generates SECRET_KEY / ENCRYPTION_KEY / REDIS_PASSWORD automatically.
# Generate manually: python -c "import secrets;print(secrets.token_urlsafe(48))"

SECRET_KEY=
ENCRYPTION_KEY=
REDIS_PASSWORD=

# Initial admin password (optional). If empty, a random one is logged on first start.
DEFAULT_ADMIN_PASSWORD=
# Demo users with well-known passwords (admin/admin123 ...). Lab use only.
SEED_DEFAULT_USERS=false

# Public origin(s) of the frontend, comma separated
CORS_ORIGINS=http://localhost:4765
FRONTEND_PORT=4765
# Secure session cookies (keep true behind HTTPS or on localhost)
COOKIE_SECURE=true

LOG_LEVEL=INFO
# Dark web / Telegram monitoring (public aggregators, minimum 15 minutes)
DARKWEB_MONITOR_ENABLED=true
DARKWEB_SCAN_INTERVAL_MINUTES=60

# Automatic watchlist checks consume API quota
WATCHLIST_SCHEDULER_ENABLED=false
