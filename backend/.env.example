# Local development settings (backend/.env)
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./threat_intel.db

# Required (>= 32 chars) when ENVIRONMENT=production.
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENCRYPTION_KEY=

# Extra allowed browser origins (dev servers on localhost are allowed automatically)
CORS_ORIGINS=

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Allow custom API sources that resolve to private/internal IPs (SSRF risk)
ALLOW_PRIVATE_API_TARGETS=false

# Demo users (admin/admin123 ...) - development only. Production creates one admin:
# SEED_DEFAULT_USERS=false
# DEFAULT_ADMIN_PASSWORD=

# Session cookies get the Secure flag in production; override if needed
# COOKIE_SECURE=

# Rate limiting: trust X-Real-IP / X-Forwarded-For only behind your own reverse proxy
TRUST_PROXY_HEADERS=false

# Parallel source requests per IOC query
IOC_QUERY_CONCURRENCY=8

# CVE exploit catalogs (Exploit-DB, Nuclei, Metasploit) downloaded at startup
EXPLOIT_INTEL_PREFETCH=true

# Dark web / Telegram monitoring (minimum interval 15 minutes)
DARKWEB_MONITOR_ENABLED=true
DARKWEB_SCAN_INTERVAL_MINUTES=60

# Automatic watchlist checks consume API quota
WATCHLIST_SCHEDULER_ENABLED=false
